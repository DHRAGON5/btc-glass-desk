# npm run setup erzeugt echte Werte. Keine Kraken Schlüssel verwenden.
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
APP_PASSWORD=GENERATE_WITH_SETUP
SESSION_SECRET=GENERATE_WITH_SETUP
VAPID_PUBLIC_KEY=GENERATE_WITH_SETUP
VAPID_PRIVATE_KEY=GENERATE_WITH_SETUP
VAPID_SUBJECT=mailto:you@example.com
DATA_DIR=./data
# Für compose.prod.yml ergänzen:
# DOMAIN=btc.deine-domain.de
# ACME_EMAIL=deine@email.de
